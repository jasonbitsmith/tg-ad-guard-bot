# 从 @BotFather 申请机器人后拿到的 token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 你的 Telegram 数字 ID（管理员，可用 @userinfobot 查询），多个用逗号分隔
ADMIN_IDS=123456789

# 命中广告后的处理方式：warn(警告计数，达到阈值后按 ESCALATE_ACTION 处理) | kick | ban
ACTION=warn

# warn 模式下，达到多少次警告后升级处理
WARN_THRESHOLD=3

# 升级处理动作：kick(踢出，可再进群) | ban(永久封禁)
ESCALATE_ACTION=kick

# 新成员保护期（分钟）：进群这段时间内检测更严格
NEW_MEMBER_GUARD_MINUTES=10

# 是否开启纯表情符号昵称+短招聘文案的"广告号画像"识别（true/false）
ENABLE_PROFILE_HEURISTIC=true
